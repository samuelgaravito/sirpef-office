# URL de la API. En desarrollo se puede dejar /api para usar el proxy de Vite.
# En un despliegue separado, usar la URL completa, por ejemplo:
# VITE_API_URL=https://api.sirpefoffice.example/api
VITE_API_URL=/api

# URL del portal SVA. Se usa para redirigir al login cuando no hay sesión SVA.
VITE_SVA_URL=http://localhost:5174
# API de SVA (cierre de sesión del portal). En producción suele ser el mismo
# origen que el portal; en desarrollo apunta al backend de SVA.
VITE_SVA_API_URL=http://localhost:5005
