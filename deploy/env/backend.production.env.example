# ─── SirpefOffice · backend de producción ──────────────────────────────────
# Copia este archivo a /etc/sirpefoffice/backend.env y completa los valores.
# Nunca subas el archivo real al repositorio.

NODE_ENV=production
HOST=127.0.0.1
PORT=3101
CORS_ORIGIN=https://sirpefoffice.mppef.gob.ve
# Flag Secure de las cookies. Sin definir: true en production.
# Pon false solo si vas a servir la aplicación por HTTP (pruebas internas).
COOKIE_SECURE=true

# ─── Base de datos ─────────────────────────────────────────────────────────
# Usa un usuario y una base dedicados, con contraseña fuerte.
DATABASE_URL=postgres://sirpefoffice:CAMBIAR_ESTA_CLAVE@127.0.0.1:5432/sirpefoffice

# ─── Autenticación ─────────────────────────────────────────────────────────
# Genera secretos nuevos con: openssl rand -hex 32
JWT_ACCESS_SECRET=CAMBIAR_ESTE_SECRETO_DE_ACCESO
JWT_REFRESH_SECRET=CAMBIAR_ESTE_SECRETO_DE_REFRESCO
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Admin local de emergencia. No se usa para entrar desde SVA.
SEED_ADMIN_EMAIL=admin@sirpefoffice.local
SEED_ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE
SEED_ADMIN_NAME=Administrador

# ─── SVA ───────────────────────────────────────────────────────────────────
# local | hybrid | sva
AUTH_MODE=sva
SVA_SERVER_URL=http://fesirpef.mppef.gob.ve
SVA_API_KEY=CAMBIAR_POR_EL_KEY_BACKEND_DEL_SISTEMA
SVA_TIMEOUT_MS=8000
SVA_SYNC_INTERVAL_MS=600000
SVA_REFRESH_TOKEN_TTL_DAYS=7

# ─── Exportación ───────────────────────────────────────────────────────────
CHROME_PATH=/usr/bin/google-chrome-stable
EXPORT_DIR=/var/lib/sirpefoffice/exports

# ─── IA (opcional) ─────────────────────────────────────────────────────────
AI_PROVIDER=none
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
