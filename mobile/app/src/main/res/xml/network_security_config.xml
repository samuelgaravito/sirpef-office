<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de desarrollo: permite HTTP para SVA y la API local.
  En producción cambia cleartextTrafficPermitted a false y usa HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
