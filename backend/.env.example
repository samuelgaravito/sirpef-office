# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3101
HOST=0.0.0.0
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Flag Secure de las cookies. Sin definir: true en production, false en desarrollo.
# COOKIE_SECURE=false

# ─── Base de datos (PostgreSQL 16 en Docker) ────────────────────────────────
POSTGRES_USER=sirpefoffice
POSTGRES_PASSWORD=sirpefoffice
POSTGRES_DB=sirpefoffice
DATABASE_URL=postgres://sirpefoffice:sirpefoffice@localhost:5433/sirpefoffice

# ─── Autenticación ─────────────────────────────────────────────────────────
# IMPORTANTE: en producción genera secretos nuevos: openssl rand -hex 32
JWT_ACCESS_SECRET=cambiame-este-secreto-de-acceso-en-produccion-0123456789
JWT_REFRESH_SECRET=cambiame-este-secreto-de-refresco-en-produccion-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Password del admin que crea el seed
SEED_ADMIN_EMAIL=admin@sirpefoffice.local
SEED_ADMIN_PASSWORD=sirpefoffice
SEED_ADMIN_NAME=Administrador

# ─── SVA: registro único de usuarios ───────────────────────────────────────
# local  = solo cuentas locales (sin SVA)
# hybrid = SVA manda y se conserva el admin local de emergencia (recomendado para el piloto)
# sva    = solo SVA; el login local queda deshabilitado
AUTH_MODE=local
SVA_SERVER_URL=http://localhost:3100
# key_backend del sistema "SirpefOffice" creado en SVA
SVA_API_KEY=
SVA_TIMEOUT_MS=8000
# Sincronización automática de la proyección de usuarios (10 min)
SVA_SYNC_INTERVAL_MS=600000
# Duración del refresh token local de un usuario SVA
SVA_REFRESH_TOKEN_TTL_DAYS=7

# ─── Proveedores de IA (opcional; el sistema funciona sin IA) ──────────────
# AI_PROVIDER=openai | anthropic | gemini | ollama | none
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── Exportación ───────────────────────────────────────────────────────────
# Ruta al navegador usado para generar PDF (puppeteer-core)
CHROME_PATH=/usr/bin/google-chrome
# Directorio donde se guardan los archivos exportados
EXPORT_DIR=./data/exports

# ─── Google Docs (opcional, para publicar el informe de ingeniería inversa) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3101/auth/google/callback
GOOGLE_DOCUMENT_ID=
