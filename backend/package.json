{
  "name": "sirpefoffice-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de SirpefOffice: Fastify, Drizzle, exportación y asistente de IA.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "postinstall": "node ../scripts/sync-shared.mjs",
    "predev": "node ../scripts/sync-shared.mjs",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "prestart": "node ../scripts/sync-shared.mjs",
    "start": "tsx src/index.ts",
    "prebuild": "node ../scripts/sync-shared.mjs",
    "build": "tsc --noEmit",
    "pretypecheck": "node ../scripts/sync-shared.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:fullwidth": "tsx scripts/migrate-fullwidth-chrome.ts",
    "db:migrate:numbering": "tsx scripts/backfill-document-numbering.ts",
    "db:reconcile-counters": "tsx scripts/reconcile-counters.ts",
    "db:purge-empty-drafts": "tsx scripts/purge-empty-drafts.ts",
    "predb:seed": "node ../scripts/sync-shared.mjs",
    "db:seed": "tsx src/db/seed.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "sva:sync": "tsx scripts/sva-sync.ts",
    "smoke:inbox": "tsx scripts/inbox-flow-smoke.ts",
    "smoke:numbering": "tsx scripts/numbering-flow-smoke.ts",
    "smoke:errors": "tsx scripts/error-smoke.ts",
    "smoke:errors:db": "tsx scripts/error-db-smoke.ts",
    "smoke:errors:ui": "node scripts/error-ui-check.mjs",
    "smoke:template-share": "tsx scripts/template-share-smoke.ts",
    "smoke:campaign": "tsx scripts/design-campaign-smoke.ts",
    "smoke:realtime": "tsx scripts/realtime-smoke.ts",
    "smoke:realtime:proxy": "node scripts/realtime-proxy-smoke.mjs",
    "smoke:bell": "node scripts/notification-bell-smoke.mjs",
    "demo:inbox": "tsx scripts/inbox-demo.ts",
    "demo:inbox:notify": "tsx scripts/inbox-demo.ts --notify",
    "demo:review": "tsx scripts/review-demo.ts",
    "smoke:pdf-bands": "tsx scripts/pdf-band-image-smoke.ts",
    "smoke:draft": "tsx scripts/draft-local-smoke.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.7",
    "@fontsource/georama": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-unique-id": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/static-renderer": "^3.32.0",
    "docx": "^9.13.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pino-pretty": "^13.1.2",
    "postgres": "^3.4.9",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3"
  }
}
