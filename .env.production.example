# SirpefOffice · entorno del stack Docker
#
# Copia este archivo a .env.production y completa los valores.
# NUNCA subas .env.production al repositorio.
#
# Genera los secretos con:
#   openssl rand -hex 32

# ─── General ───────────────────────────────────────────────────────────────
NODE_ENV=production
# Interfaz donde se publica el contenedor web.
# 127.0.0.1 = solo local (recomendado con Caddy o Nginx del host).
# 0.0.0.0   = accesible desde la red (útil para pruebas HTTP sin proxy).
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Dominio público; Caddy lo usa para pedir el certificado.
SIRPEF_DOMAIN=sirpefoffice.mppef.gob.ve

# ─── Base de datos ─────────────────────────────────────────────────────────
# En producción apunta al PostgreSQL existente del servidor.
# Si está publicado en el host: host.docker.internal:5432
# Si comparte red Docker: usa el nombre del contenedor.
DATABASE_URL=postgres://sirpefoffice:CAMBIA_ESTA_CLAVE@host.docker.internal:5432/sirpefoffice

# Solo se usan con la base local opcional (--profile local-db).
POSTGRES_USER=sirpefoffice
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=sirpefoffice

# ─── Autenticación ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CAMBIA_POR_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CAMBIA_POR_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

SEED_ADMIN_EMAIL=admin@sirpefoffice.local
SEED_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
SEED_ADMIN_NAME=Administrador

# ─── SVA ───────────────────────────────────────────────────────────────────
# local | hybrid | sva
AUTH_MODE=sva
SVA_SERVER_URL=https://sva.mppef.gob.ve
SVA_API_KEY=CAMBIA_POR_LA_KEY_BACKEND_DE_SVA
SVA_TIMEOUT_MS=8000
SVA_SYNC_INTERVAL_MS=600000
SVA_REFRESH_TOKEN_TTL_DAYS=7

# Origen permitido por CORS (el dominio público).
CORS_ORIGIN=https://sirpefoffice.mppef.gob.ve

# Flag Secure de las cookies. Sin definir: true en production.
# Para probar por HTTP sin HTTPS, pon false (solo redes internas/pruebas).
COOKIE_SECURE=false

# ─── Frontend (se congelan al construir la imagen `web`) ───────────────────
VITE_API_URL=/api
VITE_SVA_URL=https://sva.mppef.gob.ve
VITE_SVA_API_URL=https://sva.mppef.gob.ve

# ─── Exportación y zona horaria ────────────────────────────────────────────
CHROME_PATH=/usr/bin/chromium
EXPORT_DIR=/data/exports
TZ=America/Caracas

# ─── IA (opcional) ─────────────────────────────────────────────────────────
AI_PROVIDER=none
